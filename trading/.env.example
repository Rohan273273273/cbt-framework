# ── Alpaca ────────────────────────────────────────────────────────────────────
ALPACA_KEY=your_alpaca_api_key_here
ALPACA_SECRET=your_alpaca_secret_here
PAPER=true                          # set to false to go live

# ── Database ──────────────────────────────────────────────────────────────────
TIMESCALE_PASSWORD=changeme_strong_password
NEO4J_PASSWORD=changeme_strong_password

# ── External APIs (all free) ──────────────────────────────────────────────────
FRED_API_KEY=your_fred_api_key_here          # https://fred.stlouisfed.org/docs/api/api_key.html
ALPHA_VANTAGE_KEY=your_av_key_here           # https://www.alphavantage.co/support/#api-key

# ── Notifications (optional) ──────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Market Configuration ──────────────────────────────────────────────────────
CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,AVAX/USD,LINK/USD
ACTIVE_MARKET=crypto                # crypto | stocks | international

# ── Risk Limits (CRO) ─────────────────────────────────────────────────────────
CRO_MAX_TRADE_RISK_PCT=1.0          # max % of equity per trade
CRO_MAX_DAILY_LOSS_PCT=3.0          # halt new trades if daily loss exceeds this
CRO_MAX_WEEKLY_DRAWDOWN_PCT=6.0     # halt until Monday if exceeded
CRO_MAX_OPEN_POSITIONS=5
CRO_MIN_RR_RATIO=2.0

# ── ML Configuration ──────────────────────────────────────────────────────────
ML_CONFIDENCE_THRESHOLD=0.55        # min confidence to fire a trade
ML_LGBM_MODEL_PATH=/app/models/lgbm_selector.pkl

# ── Agent Configuration ───────────────────────────────────────────────────────
AGENT_CYCLE_INTERVAL_SECONDS=900    # 15 minutes
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=10
